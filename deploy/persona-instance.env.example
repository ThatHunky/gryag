# Copy to instances/<name>.env. Everything not set here comes from .env, including the
# Gemini key, so set every line below: DB_PATH above all, or this instance writes into
# gryag's own database.

# The variable in .env holding this bot's token. Missing, the process refuses to start
# rather than fall back to gryag's TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN_VAR=SOMEONE_PERSONA_TOKEN

# How its own lines are labelled in the prompt, and what it answers to besides an
# @mention or a reply. Keep the keyword unlike the real person's name, or every message
# about them wakes the bot.
BOT_ALIAS=name
BOT_KEYWORDS=namebot

PERSONA_PATH=eval/personas/name.txt
# Optional. One phrase a line; leave it out for no dictionary.
PHRASES_PATH=eval/personas/phrases/name.txt

DB_PATH=/home/thathunky/bots/gryag-v2/instances/name.db

# Talk only: no /pidor, /summary, /lore or daily posts, which stay with gryag.
CHAT_ONLY=1
# No port or Caddy route needed.
MODE=polling
